{
  "name": "electron-calendar",
  "version": "2.0.0",
  "description": "Supernova desktop calendar",
  "main": "main.js",
  "scripts": {
    "ng": "ng",
    "start:ng": "ng serve",
    "start": "electron .",
    "dev": "concurrently -k \"ng serve\" \"wait-on http://localhost:4200 && electron .\"",
    "build:renderer": "ng build --configuration production --base-href ./",
    "build": "npm run build:renderer && electron-builder"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@angular-devkit/build-angular": "latest",
    "@angular/cli": "latest",
    "@angular/compiler-cli": "latest",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "electron": "^40.8.0",
    "electron-builder": "^26.8.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.5.4",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "@angular/animations": "latest",
    "@angular/common": "latest",
    "@angular/compiler": "latest",
    "@angular/core": "latest",
    "@angular/forms": "latest",
    "@angular/platform-browser": "latest",
    "@angular/platform-browser-dynamic": "latest",
    "rxjs": "latest",
    "zone.js": "latest"
  },
  "build": {
    "appId": "com.calendar.desktop",
    "productName": "Supernova Calendar",
    "files": [
      "dist/renderer/**",
      "main.js",
      "preload.js",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
